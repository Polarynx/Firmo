<?xml version="1.0" encoding="UTF-8"?>
<!--
  Firmo for Word.

  Students do not write in Firmo. They write in Word, and every minute of the
  workflow that asks them to leave it is a minute where the tool loses. So the
  two passes that only matter against a finished document — what needs a source,
  and whether the references are real — run inside the document itself.

  This is a task pane add-in, not a web app in a frame: it reads the real body
  text through Office.js, highlights the real paragraphs, and writes citations
  at the real cursor.

  To sideload for development, see README.md. The Id below must be a unique
  GUID; regenerate it if you fork this.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>4f2c1e88-9a3d-4c17-b6ea-1d5f0c7a2b31</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Firmo</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Firmo" />
  <Description DefaultValue="Mark every claim that needs a source, and check every reference against the publisher record — without leaving your document." />
  <IconUrl DefaultValue="https://firmo.app/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://firmo.app/icon-80.png" />
  <SupportUrl DefaultValue="https://firmo.app/help" />

  <AppDomains>
    <AppDomain>https://firmo.app</AppDomain>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <!-- WordApi 1.3 is the floor: it is where `Range.search` and paragraph-level
         font formatting arrive, which is everything the highlighting depends on. -->
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://firmo.app/addins/word/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Firmo.Group">
                <Label resid="Firmo.GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Firmo.Icon16" />
                  <bt:Image size="32" resid="Firmo.Icon32" />
                  <bt:Image size="80" resid="Firmo.Icon80" />
                </Icon>
                <Control xsi:type="Button" id="Firmo.OpenPane">
                  <Label resid="Firmo.OpenLabel" />
                  <Supertip>
                    <Title resid="Firmo.OpenLabel" />
                    <Description resid="Firmo.OpenTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Firmo.Icon16" />
                    <bt:Image size="32" resid="Firmo.Icon32" />
                    <bt:Image size="80" resid="Firmo.Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Firmo.Taskpane</TaskpaneId>
                    <SourceLocation resid="Firmo.PaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Firmo.Icon16" DefaultValue="https://firmo.app/icon-16.png" />
        <bt:Image id="Firmo.Icon32" DefaultValue="https://firmo.app/icon-32.png" />
        <bt:Image id="Firmo.Icon80" DefaultValue="https://firmo.app/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Firmo.PaneUrl" DefaultValue="https://firmo.app/addins/word/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://firmo.app/help" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Firmo.GroupLabel" DefaultValue="Firmo" />
        <bt:String id="Firmo.OpenLabel" DefaultValue="Check this draft" />
        <bt:String id="GetStarted.Title" DefaultValue="Firmo is ready." />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Firmo.OpenTip" DefaultValue="Mark every sentence that needs a source, and verify every reference against the publisher record." />
        <bt:String id="GetStarted.Description" DefaultValue="Open Firmo from the Home tab to check the claims in your draft." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
