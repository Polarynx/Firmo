# Firmo backend configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the only
# record of what exists, which is the point — OPENALEX_MAILTO sat unset for
# months, quietly throttling every citation lookup, because nothing anywhere
# listed it as a thing you were supposed to set.
#
# Only MISTRAL_API_KEY is required to boot. Everything else has a default that
# works locally and at least one that does not work in production.


# ── Required ────────────────────────────────────────────────────────────────

# The model provider. Nothing runs without this.
MISTRAL_API_KEY=

# Signs session tokens. The app REFUSES TO START in production without it,
# because the fallback is a value published in auth.py and every session would
# be forgeable by anyone who reads the source. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FIRMO_SECRET=


# ── Politeness, and why it is not optional in practice ──────────────────────

# A real address you own. OpenAlex is the index Firmo leans on hardest —
# keyword search, seed resolution, references and cited-by all go through it,
# so one search can spend a dozen calls there — and it meters by BUDGET as well
# as by rate. In the common pool you hit "Insufficient budget" constantly, and
# citation expansion, which is what finds the canonical papers a keyword search
# misses, is the first thing to starve.
#
# Leave it blank rather than inventing something: a placeholder at example.com
# is IANA-reserved, can never receive mail, and gets read as junk, so you pay
# the cost of identifying yourself for none of the benefit. Firmo detects that
# case and sends nothing instead.
OPENALEX_MAILTO=

# Same idea, for Unpaywall's open-access PDF lookups.
UNPAYWALL_EMAIL=

# Optional. Raises Semantic Scholar's rate limit; searches work without it.
SEMANTIC_SCHOLAR_API_KEY=


# ── Models ──────────────────────────────────────────────────────────────────

# The volume model: planning queries, formatting, summarising.
FIRMO_MODEL=mistral-small-latest

# Reserved for judgements rather than transformations.
FIRMO_REASONING_MODEL=mistral-large-latest

# Which model judges relevance and assigns roles during a search — the highest
# leverage call in the product, since it decides which sixty of four hundred
# papers a student ever sees.
#
# Defaults to FIRMO_MODEL, and that default is MEASURED rather than assumed.
# Pointing it at the large model is the obvious improvement and made retrieval
# twenty times worse on a standard-tier key: eight rerank chunks per search is
# more large-model traffic than the quota serves, every chunk 429s, and the
# fallback is silent — the search looks completely normal while ranking badly.
# On the 32-case benchmark: recall@10 0.312 small, 0.016 large-and-throttled.
#
# Raise the quota FIRST, then set this, then re-run backend/eval/run_eval.py
# and check the "[rerank] DEGRADED" line stays silent.
FIRMO_RERANK_MODEL=

# How many rerank chunks may be in flight at once, process-wide. Two is the
# price of not tripping the rate limit. Raise it on a key with a bigger quota.
FIRMO_RERANK_CONCURRENCY=2


# ── Deployment ──────────────────────────────────────────────────────────────

# Postgres in production; omit for the local SQLite file.
#   postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=

# Comma-separated browser origins allowed to call the API. The Word add-in and
# the browser extensions are matched by ALLOWED_ORIGIN_REGEX instead, which has
# a working default — note that Word for the web sends the Office frame's
# origin, not the add-in's, so allowing only your own domain silently breaks
# the web version while the desktop one keeps working.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "production" to enforce the FIRMO_SECRET check off Render.
FIRMO_ENV=

# Per-user and per-IP request ceilings.
FIRMO_DAILY_LIMIT=
FIRMO_IP_CEILING=
